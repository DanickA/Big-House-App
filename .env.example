# =========================================================
# CONFIGURACIÓN DE PRODUCCIÓN / ENTORNO - HOGARAPP
# =========================================================

# 1. Base de datos PostgreSQL (Neon, Supabase o local)
# Ejemplo Neon: postgresql://usuario:password@ep-cool-pool-12345.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL="postgresql://usuario:password@localhost:5432/hogar_db?schema=public"

# 2. Clave secreta para autenticación de sesiones (JWT)
# Genera una clave aleatoria segura con: openssl rand -base64 32
# o en https://generate-secret.vercel.app/32
# Recomendado: SESSION_SECRET (también se admite JWT_SECRET como alias de compatibilidad)
SESSION_SECRET="tu-clave-secreta-super-segura-aqui"
# JWT_SECRET="tu-clave-secreta-super-segura-aqui"

# 3. Almacenamiento de Fotos y Comprobantes en la Nube (Cloudinary - Gratuito)
# OBLIGATORIO EN PRODUCCIÓN / VERCEL: En plataformas serverless el sistema de archivos
# es efímero y de solo lectura. Sin Cloudinary, la subida de imágenes y comprobantes
# fallará intencionalmente con un error explicativo para evitar pérdida de datos o EROFS.
# Obtén estos datos en tu panel de control de https://console.cloudinary.com -> Product Environment Credentials
# IMPORTANTE: El Cloud Name NO es el nombre de tu proyecto o cuenta; es el identificador en minúsculas asignado por Cloudinary (ej: "dqxyz123" o "bighouseapp").
CLOUDINARY_CLOUD_NAME="tu_cloud_name_en_minusculas"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# O alternativamente, puedes usar la URL completa (CLOUDINARY_URL) que Cloudinary te da con 1 clic en su panel:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
