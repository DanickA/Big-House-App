generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model gastos {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  descripcion String     @db.VarChar(200)
  monto       Decimal    @db.Decimal(12, 2)
  fecha       DateTime   @db.Date
  categoria   String     @db.VarChar(50)
  usuario_id  String     @db.Uuid
  servicio_id String?    @db.Uuid
  servicios   servicios? @relation(fields: [servicio_id], references: [id], onUpdate: NoAction, map: "fk_servicio_gasto")
  usuarios    usuarios   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_gasto")

  @@index([usuario_id])
  @@index([servicio_id])
  @@index([fecha])
}

model historial_cuidado {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tarea_id        String         @db.Uuid
  usuario_id      String         @db.Uuid
  fecha_realizada DateTime?      @default(now()) @db.Timestamp(6)
  observaciones   String?
  tareas_cuidado  tareas_cuidado @relation(fields: [tarea_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tarea_historial")
  usuarios        usuarios       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_historial")

  @@index([tarea_id])
  @@index([usuario_id])
  @@index([fecha_realizada])
  @@index([tarea_id, fecha_realizada])
}

model ingresos {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  descripcion     String   @db.VarChar(200)
  monto           Decimal  @db.Decimal(12, 2)
  fecha           DateTime @db.Date
  fuente          String?  @db.VarChar(50)
  comprobante_url String?
  usuario_id      String   @db.Uuid
  usuarios        usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_ingreso")

  @@index([usuario_id])
  @@index([fecha])
}

model plantas {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_comun   String           @db.VarChar(100)
  especie        String?          @db.VarChar(100)
  ubicacion      String           @db.VarChar(100)
  foto_url       String?
  nivel_luz      String?          @default("INDIRECTA") @db.VarChar(30)
  nivel_agua     String?          @default("MODERADA") @db.VarChar(30)
  estado_salud   String?          @default("SANA") @db.VarChar(30)
  notas_cuidado  String?
  tareas_cuidado tareas_cuidado[]
}

model servicios {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_servicio    String            @db.VarChar(100)
  numero_cuenta      String?           @db.VarChar(50)
  numero_factura     String?           @db.VarChar(50)
  monto              Decimal           @db.Decimal(12, 2)
  fecha_vencimiento  DateTime          @db.Date
  estado             String            @default("PENDIENTE") @db.VarChar(20)
  periodicidad_meses Int?              @default(1)
  dia_vencimiento    Int?
  responsable_id     String?           @db.Uuid
  activo             Boolean           @default(true)
  responsable        usuarios?         @relation("ResponsableServicio", fields: [responsable_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_responsable_servicio")
  gastos             gastos[]
  pagos_servicios    pagos_servicios[]

  @@index([fecha_vencimiento])
  @@index([estado])
  @@index([responsable_id])
  @@index([activo])
}

model tareas_cuidado {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planta_id         String              @db.Uuid
  tipo_tarea        String              @db.VarChar(50)
  frecuencia_dias   Int
  proxima_fecha     DateTime            @db.Date
  historial_cuidado historial_cuidado[]
  plantas           plantas             @relation(fields: [planta_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_planta_tarea")

  @@index([planta_id])
  @@index([proxima_fecha])
  @@index([planta_id, tipo_tarea])
}

model usuarios {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                String               @db.VarChar(100)
  email                 String               @unique @db.VarChar(150)
  password_hash         String               @db.VarChar(255)
  fecha_registro        DateTime?            @default(now()) @db.Timestamp(6)
  pin_hash              String?              @db.VarChar(255)
  pin_longitud          Int?                 @default(4)
  rol                   RolUsuario           @default(MIEMBRO)
  token_version         Int                  @default(1)
  activo                Boolean              @default(true)
  gastos                gastos[]
  historial_cuidado     historial_cuidado[]
  ingresos              ingresos[]
  pagos_servicios       pagos_servicios[]
  servicios_responsable servicios[]          @relation("ResponsableServicio")
  
  eventos_creados       eventos[]            @relation("CreadorEvento")
  eventos_participados  eventos[]            @relation("ParticipantesEvento")
  subtareas_asignadas   subtareas_evento[]   @relation("SubtareasAsignadas")
  suscripciones_push    suscripciones_push[]
  conexion_google       conexiones_google?
}

model pagos_servicios {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  servicio_id         String    @db.Uuid
  usuario_id          String    @db.Uuid
  monto_pagado        Decimal   @db.Decimal(12, 2)
  monto_presupuestado Decimal?  @db.Decimal(12, 2)
  fecha_pago          DateTime? @default(now()) @db.Timestamp(6)
  comprobante_url     String?
  observaciones       String?
  servicios           servicios @relation(fields: [servicio_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_servicio_pago")
  usuarios            usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_pago")

  @@index([servicio_id])
  @@index([usuario_id])
  @@index([fecha_pago])
}

enum RolUsuario {
  ADMIN
  MIEMBRO
}

enum TipoPlantilla {
  EVENTO
  TAREA
  MANTENIMIENTO
  VISITAS
  COMPRAS
  MASCOTAS
  CUMPLEANOS
  CITA_MEDICA
  MERCADO
}

enum EstadoEvento {
  ACTIVO
  CANCELADO
  COMPLETADO
}

enum CanalRecordatorio {
  PUSH
  EMAIL
}

model eventos {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo          String         @db.VarChar(200)
  descripcion     String?
  tipo_plantilla  TipoPlantilla
  estado          EstadoEvento   @default(ACTIVO)
  fecha_inicio    DateTime       @db.Timestamp(6)
  fecha_fin       DateTime       @db.Timestamp(6)
  todo_el_dia     Boolean        @default(false)
  color           String         @db.VarChar(50)
  ubicacion       String?        @db.VarChar(200)
  recurrencia     String?        @db.VarChar(100)
  detalles        Json?
  creador_id      String         @db.Uuid
  fecha_creacion  DateTime?      @default(now()) @db.Timestamp(6)
  google_event_id String?        @unique @db.VarChar(255)

  creador         usuarios       @relation("CreadorEvento", fields: [creador_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_creador_evento")
  participantes   usuarios[]     @relation("ParticipantesEvento")
  
  externos        participantes_externos[]
  subtareas       subtareas_evento[]
  recordatorios   recordatorios_evento[]

  @@index([fecha_inicio, fecha_fin])
  @@index([creador_id])
  @@index([estado])
  @@index([google_event_id])
}

model participantes_externos {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_id       String         @db.Uuid
  nombre          String         @db.VarChar(100)
  contacto        String?        @db.VarChar(100)
  
  evento          eventos        @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evento_externo")

  @@index([evento_id])
}

model subtareas_evento {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_id       String         @db.Uuid
  descripcion     String         @db.VarChar(200)
  completado      Boolean        @default(false)
  asignado_id     String?        @db.Uuid
  
  evento          eventos        @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evento_subtarea")
  asignado        usuarios?      @relation("SubtareasAsignadas", fields: [asignado_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_usuario_subtarea")

  @@index([evento_id])
  @@index([asignado_id])
}

model recordatorios_evento {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_id           String         @db.Uuid
  tipo_canal          CanalRecordatorio
  minutos_anticipacion Int
  fecha_programada    DateTime       @db.Timestamp(6)
  enviado             Boolean        @default(false)
  
  evento              eventos        @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evento_recordatorio")

  @@index([evento_id])
  @@index([enviado, fecha_programada])
}

model suscripciones_push {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id          String         @db.Uuid
  endpoint            String
  p256dh              String
  auth                String
  fecha_creacion      DateTime?      @default(now()) @db.Timestamp(6)

  usuario             usuarios       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_suscripcion")

  @@index([usuario_id])
}

model conexiones_google {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String    @unique @db.Uuid
  access_token   String    @db.Text
  refresh_token  String    @db.Text
  token_expira   DateTime  @db.Timestamp(6)
  calendar_id    String    @default("primary") @db.VarChar(100)
  sync_token     String?   @db.Text
  ultima_sync    DateTime? @db.Timestamp(6)
  fecha_creacion DateTime? @default(now()) @db.Timestamp(6)

  usuario        usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_conexion_google")

  @@index([usuario_id])
}
