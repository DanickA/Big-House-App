# =========================================================
# CONFIGURACIÓN DE PRODUCCIÓN / ENTORNO - HOGARAPP
# =========================================================

# 1. Base de datos PostgreSQL (Neon, Supabase o local)
# Ejemplo Neon: postgresql://usuario:password@ep-cool-pool-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:password@localhost:5432/hogar_db?schema=public"

# 2. Clave secreta para autenticación de sesiones (JWT)
# Puedes generar una clave aleatoria segura en https://generate-secret.vercel.app/32
JWT_SECRET="tu-clave-secreta-super-segura-aqui"

# 3. Almacenamiento de Fotos en la Nube (Cloudinary - Gratuito)
# Obtén estos datos en tu panel de control de https://console.cloudinary.com -> Product Environment Credentials
# IMPORTANTE: El Cloud Name NO es el nombre de tu proyecto o cuenta; es el identificador en minúsculas asignado por Cloudinary (ej: "dqxyz123" o "bighouseapp").
CLOUDINARY_CLOUD_NAME="tu_cloud_name_en_minusculas"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# O alternativamente, puedes usar la URL completa (CLOUDINARY_URL) que Cloudinary te da con 1 clic en su panel:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
